# ============================================================
# Omedo HMS — Contact Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ============================================================

# Server port (default 5000)
PORT=5000

# ----------------------------------------------------------
# SMTP Configuration
# ----------------------------------------------------------
# Examples:
#   Gmail:     smtp.gmail.com  / 587 (TLS) or 465 (SSL)
#   Outlook:   smtp-mail.outlook.com / 587
#   Zoho:      smtp.zoho.in / 587
#   Custom:    your mail server host

SMTP_HOST=
SMTP_PORT=587
# Set to true if using port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ----------------------------------------------------------
# Email Addresses
# ----------------------------------------------------------
# The business email where enquiries should be delivered
OWNER_EMAIL=

# ----------------------------------------------------------
# URLs
# ----------------------------------------------------------
# Your production frontend URL (used in CORS allowlist)
# Example: https://www.omedo.in
FRONTEND_URL=

# Your website URL shown in the email body
# Example: https://www.omedo.in
WEBSITE_URL=
